node_modules/
node_modules
out/
dist/
.DS_Store
*.log
.vite/
.env
.env.local
.env.signing
.gstack/

# signing / notarization secrets — NEVER commit these
*.p8
*.p12
*.cer
*.mobileprovision
build/AuthKey_*.p8

# heavy hero source — only the compressed hero.mp4/.webm are deployed
docs/media/*.mov

# git worktree mounts for hive worker agents — never commit (each is a separate branch checkout)
.worktrees/

# raw demo screen recordings — only the compressed docs/media/demo/*.mp4 are deployed
docs/media/MunderDifflin*.mp4

# blog theme previews (local only)
docs/blog-preview-*/

# stray built bundles at the repo root (a 12 MB one skewed GitHub's language stats)
/index-*.js

# Finder duplicate files, e.g. "spec 2.js", "sitemap 2.xml"
*\ 2.*
*\ [0-9].*

# munder link / control state — identidades, peers y recibos viven con 0600
# FUERA del repo (~/.local/state/munder/, userData). Si alguna copia cae en
# el arbol, esto impide commitearla: pierdes el peer, no la llave.
link/
avatar-overrides.json
munder-control.json
identity.json
peers.json
pending.json
receipts.jsonl
*.pid

# Android (MunderMobile): SDK local, compilados y capturas — nunca al repo.
# El APK se distribuye por el artifact del CI, no por git.
android/MunderMobile/local.properties
android/MunderMobile/.gradle/
android/MunderMobile/build/
android/MunderMobile/app/build/
android/MunderMobile/shots/
*.apk
*.aab
