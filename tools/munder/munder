// Canal de control de la app viva (M0+): loopback + token por boot.
// Lee {port,token} de munder-control.json en el userData de la app.
// La app lo borra al cerrarse limpio; si muere antes queda HUÉRFANO
// (puerto cerrado + sin procesos): se detecta y se poda, nunca en caliente.
function userDataDir() {
  return process.env.MUNDER_USER_DATA || path.join(os.homedir(), '.config', 'munder-difflin');
}
function channelCfgFile() {
  return path.join(userDataDir(), 'munder-control.json');
}
function readChannelCfg() {
  // null = sin archivo; {corrupt} | {cfg}. Nunca muere.
  let cfg;
  try {
    cfg = JSON.parse(fs.readFileSync(channelCfgFile(), 'utf8'));
  } catch {
    return null;
  }
  if (!cfg || typeof cfg.port !== 'number' || typeof cfg.token !== 'string') {
    return { corrupt: true };
  }
  return { cfg };
}
function readChannel() {
  const r = readChannelCfg();
  if (!r) die(`sin canal (no se lee ${channelCfgFile()}): ¿la app está corriendo con build que lo trae?`);
  if (r.corrupt) die(`${channelCfgFile()} corrupto (se esperaba {port, token}). Prueba: munder ctl limpiar`);
  return r.cfg;
}
async function probeChannel(cfg, ms = 5000) {
  // {alive} | {down, detail}. Nunca muere.
  try {
    const res = await fetch(`http://127.0.0.1:${cfg.port}/salud`, {
      headers: { authorization: `Bearer ${cfg.token}` },
      signal: AbortSignal.timeout(ms),
    });
    const body = await res.json().catch(() => ({}));
    if (res.status === 200 && body && body.ok === true) return { alive: true };
    return { down: true, detail: `respondió ${res.status}` };
  } catch (e) {
    return { down: true, detail: (e && e.cause && (e.cause.code || e.cause)) || (e && e.message) || String(e) };
  }
}
// 'viva' | 'huerfana' | 'caida' | 'ausente' | 'corrupta'. Nunca muere.
// Huérfana = archivo + puerto cerrado + ningún proceso del checkout
// (con procesos vivos puede ser arranque en curso: no se toca).
async function channelState() {
  const r = readChannelCfg();
  if (!r) return { state: 'ausente' };
  if (r.corrupt) return { state: 'corrupta', file: channelCfgFile() };
  const p = await probeChannel(r.cfg);
  if (p.alive) return { state: 'viva', port: r.cfg.port };
  if (pids().length) return { state: 'caida', port: r.cfg.port, detail: p.detail };
  return { state: 'huerfana', port: r.cfg.port, file: channelCfgFile(), detail: p.detail };
}
// Poda el huérfano si lo hay. true = se eliminó algo.
async function pruneChannelOrphan() {
  const r = readChannelCfg();
  if (!r) return false;
  if (r.corrupt) {
    try { fs.unlinkSync(channelCfgFile()); } catch { return false; }
    console.log('munder: archivo de canal corrupto eliminado.');
    return true;
  }
  const p = await probeChannel(r.cfg, 3000);
  if (p.alive) return false;
  if (pids().length) return false;
  try { fs.unlinkSync(channelCfgFile()); } catch { return false; }
  console.log(`munder: canal huérfano eliminado (puerto ${r.cfg.port}). Arranca con munder start.`);
  return true;
}

async function channelCall(method, p, body, token) {
  const r = await fetch(`http://127.0.0.1:${p.port}${p.path}`, {
    method,
    headers: {
      authorization: `Bearer ${token}`,
      ...(body !== undefined ? { 'content-type': 'application/json' } : {}),
    },
    ...(body !== undefined ? { body: JSON.stringify(body) } : {}),
    signal: AbortSignal.timeout(15000),
  });
  return { status: r.status, body: await r.json().catch(() => ({})) };
}

// M1: ver la sesión viva (registry + PTYs vía buildSessionView en main).
async function cmdSesionVer() {
  const ch = readChannel();
  const r = await channelCall('GET', { port: ch.port, path: '/sesion' }, undefined, ch.token)
    .catch((e) => die(`sin respuesta del canal (${e && e.message ? e.message : e})`));
  if (r.status !== 200 || !r.body || r.body.ok !== true || !Array.isArray(r.body.agents)) {
    die(`no se pudo leer la sesión (${r.status}): ${(r.body && r.body.error) || 'sin detalle'}`);
  }
  const agents = r.body.agents;
  if (!agents.length) {
    console.log('munder: sesión vacía (0 agentes).');
    return;
  }
  const rows = agents.map((a) => ({
    id: String(a.id ?? '?'),
    nombre: String(a.name ?? a.id ?? '?'),
    proveedor: String(a.provider ?? '—'),
    rol: String(a.role ?? '—'),
    estado: a.live ? st('vivo', C.green) : st('apagado', C.dim),
    pid: a.pid != null ? String(a.pid) : '—',
  }));
  const w = {};
  for (const k of Object.keys(rows[0])) w[k] = Math.max(k.length, ...rows.map((r) => r[k].replace(/\x1b\[[0-9;]*m/g, '').length));
  const line = (r) => Object.keys(w).map((k) => r[k].padEnd(w[k])).join('  ');
  console.log('  ' + st(line({ id: 'ID', nombre: 'NOMBRE', proveedor: 'PROVEEDOR', rol: 'ROL', estado: 'ESTADO', pid: 'PID' }), C.bold, C.dim));
  for (const r of rows) console.log('  ' + line(r));
  console.log(st(`  ${agents.length} agente(s), ${agents.filter((a) => a.live).length} vivo(s).`, C.dim));
}

// M2: armar/quitar agentes contra la instancia viva (vía spawnAgentCore,
// mismo contrato que pty:spawn; el main valida e infiere proveedor).
async function cmdSesion(args) {
  const [sub, ...rest] = args;
  if (sub === 'ver') return await cmdSesionVer();
  if (sub === 'proveedor') return await cmdSesionProveedor(rest);
  if (sub === 'armar') return await cmdSesionArmar(rest);
  if (sub === 'quitar') {
    const id = rest[0];
    if (!id) die("uso: munder sesion quitar <id>  (id de agente o de pty)");
    const ch = readChannel();
    const r = await channelCall('DELETE', { port: ch.port, path: `/sesion/agentes/${encodeURIComponent(id)}` }, undefined, ch.token)
      .catch((e) => die(`sin respuesta del canal (${e && e.message ? e.message : e})`));
    if (r.status === 200 && r.body && r.body.ok === true) {
      console.log(`munder: agente ${r.body.id} eliminado.`);
      return;
    }
    die(`no se pudo quitar (${r.status}): ${(r.body && r.body.error) || 'sin detalle'}`);
  }
  die("uso: munder sesion ver | munder sesion proveedor [--cli X --endpoint Y --model Z] | munder sesion armar [--nombre X --comando \"...\" --cwd ...] | munder sesion quitar <id>");
}

// Adaptadores IO reales para chatearPersonaje (lib-personaje.cjs).
const chatIO = {
