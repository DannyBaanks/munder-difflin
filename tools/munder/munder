function loadAvatarEngine() {
  // Lazy: el engine solo se necesita para compilar (no para lienzo/editar).
  try {
    return require('./avatar-engine.cjs');
  } catch (e) {
    die(`falta el engine (tools/munder/avatar-engine.cjs). Genéralo: node tools/munder/sync-avatar-engine.cjs (${e && e.code ? e.code : 'ver error'})`);
  }
}

const AVATAR_MOTORS = ['local', 'modelo', 'flow', 'spec'];

function cmdAvatarCompilar(desc, opts) {
  opts = opts || {};
  const partFlags = ['piel', 'pelo', 'ojos', 'ropa', 'pantalon', 'zapatos'].filter((k) => opts[k]);
  if ((!desc || !String(desc).trim()) && !(opts.motor === 'spec' && (partFlags.length || opts.dsl))) {
    if (!IS_TTY) die('uso: munder avatar compilar "piel morena, pelo negro corto..." [--motor local|modelo|flow|spec] [--salida x.png]');
    die('sin descripción, cancelado.');
  }
  const motor = opts.motor || 'local';
  if (!AVATAR_MOTORS.includes(motor)) die(`motor desconocido '${motor}'. Opciones: ${AVATAR_MOTORS.join(', ')}`);
  if (motor === 'spec') return cmdAvatarCompilarSpec(desc, resolveAvatarOut(opts), opts);
  const { parseAvatarDesc, compileAvatar } = require('./lib-avatar.cjs');
  const parsed = parseAvatarDesc(String(desc));
  for (const w of parsed.warnings) console.log(st(`  ~ ${w}`, C.yellow));
  const out = resolveAvatarOut(opts);
  if (motor === 'modelo') return cmdAvatarCompilarModelo(desc, parsed, out, opts);
  if (motor === 'flow') return cmdAvatarCompilarFlow(desc, parsed, out, opts);
  // local: engine procedural (sin red, determinista).
  const engine = loadAvatarEngine();
  let compiled;
  try {
    compiled = compileAvatar(engine, String(desc));
  } catch (e) {
    die(`no se pudo compilar: ${e.message}`);
  }
  fs.writeFileSync(out, compiled.png);
  return finishAvatarCompilar(out, compiled.recipe, parsed.warnings);
}

function resolveAvatarOut(opts) {
  const stamp = Date.now().toString(36);
  const out = opts.salida
    ? path.resolve(expandTilde(opts.salida))
    : path.resolve(`./avatar-18x28-${stamp}.png`);
  if (fs.existsSync(out)) die(`ya existe ${out} (bórralo o pasa --salida).`);
  return out;
}

function finishAvatarCompilar(out, recipe, warnings) {
  // Bloque de éxito ÚNICO para los tres motores (contrato para agentes:
  // misma forma salga de donde salga el PNG).
  const { verifyAvatar, decodePNG } = require('./lib-avatar.cjs');
