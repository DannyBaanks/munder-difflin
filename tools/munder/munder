function askHidden(question) {
  // Entrada oculta 100% en proceso (sin eco, muestra *). A propósito NO usa
  // `read -s` externo: los bytes sobrantes de selects previos viven en el
  // buffer de Node (unshift) y un proceso hijo leyendo el pty no los vería —
  // se colgaría esperando una línea que ya consumimos nosotros.
  return new Promise((resolve) => {
    const stdin = process.stdin;
    let acc = '', done = false;
    process.stdout.write(question + C.hide);
    const cleanup = () => {
      stdin.removeListener('data', onData);
      try { if (stdin.isTTY) stdin.setRawMode(false); } catch { /* noop */ }
      try { stdin.pause(); } catch { /* noop */ }
      process.stdout.write('\n' + C.show);
    };
    const onData = (chunk) => {
      if (done) return;
      const text = chunk.toString('utf8');
      for (let k = 0; k < text.length; k++) {
        const ch = text[k];
        if (ch === '\u0003') { cleanup(); done = true; process.exitCode = 130; process.exit(130); return; }
        if (ch === '\r' || ch === '\n') {
          const v = acc; acc = '';
          // Lo que venga después en este chunk pertenece al siguiente prompt.
          const rest = text.slice(k + 1);
          cleanup();
          if (rest.length) { try { stdin.unshift(Buffer.from(rest, 'utf8')); } catch { /* noop */ } }
          done = true;
          resolve(v.trim());
          return;
        }
        if (ch === '\u007f' || ch === '\b') {
          if (acc.length) { acc = acc.slice(0, -1); process.stdout.write('\b \b'); }
          continue;
        }
        if (ch >= ' ' || ch === '\t') { acc += ch; process.stdout.write('*'); }
      }
    };
    try { stdin.setRawMode(true); } catch { resolve(''); return; }
    stdin.resume();
    stdin.on('data', onData);
  });
}

// Solo estas rutas puede escribir el linker. Todo lo demás son instrucciones.
function writableAuthPath(cliId) {
  const c = CLI_DETECT.find((x) => x.id === cliId);
  if (!c || !c.writableAuth) return null;
  return path.join(os.homedir(), c.writableAuth);
}

function linkKeyToCli(cliId, keyValue) {
  // Devuelve {ok, where} o {ok:false, manual}. NUNCA escribe fuera del allowlist.
  const dest = writableAuthPath(cliId);
  if (!dest) {
    const c = CLI_DETECT.find((x) => x.id === cliId);
    return { ok: false, manual: c && c.login ? `usa el login propio: ${c.login}` : 'revisa el login propio del CLI' };
  }
  let current = {};
  try {
    if (fs.existsSync(dest)) current = JSON.parse(fs.readFileSync(dest, 'utf8'));
    if (typeof current !== 'object' || current === null || Array.isArray(current)) current = {};
  } catch {
    return { ok: false, manual: `${dest} existe pero no es JSON válido — edítalo a mano` };
  }
  try {
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    if (fs.existsSync(dest)) fs.copyFileSync(dest, dest + '.bak-munder');
    current.OPENAI_API_KEY = keyValue;
    fs.writeFileSync(dest, JSON.stringify(current, null, 2) + '\n', { mode: 0o600 });
    return { ok: true, where: dest };
  } catch (e) {
    return { ok: false, error: `no se pudo escribir ${dest}: ${e && e.message ? e.message : e}` };
  }
}

