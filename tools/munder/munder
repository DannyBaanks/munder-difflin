// ─── dispatch ──────────────────────────────────────────────────────────────
async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  if (!cmd) {
    if (IS_TTY) { await interactiveMenu(); return; }
    printHelp(); return;
  }
  switch (cmd) {
    case 'start': await cmdStart(rest.includes('--fg')); break;
    case 'stop': await cmdStop(); break;
    case 'restart': await cmdStop(); await cmdStart(rest.includes('--fg')); break;
    case 'status': await cmdStatus(); break;
    case 'logs': case 'log': cmdLogs(rest); break;
    case 'create-harness': case 'create': case 'new-harness': await cmdCreateHarness(rest[0] ?? null, rest[1] ?? null); break;
    case 'sesion': case 'session': await cmdSesion(rest); break;
    case 'avatar': await cmdAvatar(rest); break;
    case 'repaint': await cmdRepaint(); break;
    case 'ctl': await cmdCtl(rest); break;
    case 'ps': cmdPs(); break;
    case 'check': cmdCheck(); break;
    case '--stop': await cmdStop(); break;
    case '--check': cmdCheck(); break;
    case '--fg': await cmdStart(true); break;
    case 'help': case '--help': case '-h': printHelp(); break;
    default: die(`comando desconocido '${cmd}'. Usa: munder {start|stop|restart|status|logs|create-harness|ps|check|help}`);
  }
}

main().catch((e) => { console.error(`munder: error inesperado: ${e && e.message ? e.message : e}`); process.exit(1); });
