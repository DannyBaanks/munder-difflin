  console.log('');
  console.log(st('  Revisa antes de enviar (llamada con costo potencial):', C.bold));
  console.log(`    endpoint: ${endpoint.label} (${baseURL})`);
  console.log(`    modelo:   ${opts.model}`);
  console.log(`    imagen:   ${abs} (${fs.statSync(abs).size} bytes)`);
