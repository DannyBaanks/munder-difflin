function dieInvalidSpec(err) {
  // Bucle de corrección en forma CLI: motivo + qué sí vale.
  const avail = (err.error.available || []).join(', ');
  die(`INVALID_ENUM ${err.error.field}: '${err.error.value}'. Opciones: ${avail}`);
}

// Partes seleccionables por flag (M3): cada valor se normaliza con una frase
// sintética de su categoría y solo aporta su parte (el resto lo pone --motor
// spec desde la descripción o la base neutra).
const SPEC_PART_FLAGS = [
  ['piel', (v) => `piel ${v}`, (spec, r) => { spec.skin = r.spec.skin; }],
  ['pelo', (v) => `pelo ${v}`, (spec, r) => { spec.hair = r.spec.hair; }],
  ['ojos', (v) => `ojos ${v}`, (spec, r) => { spec.eyes = r.spec.eyes; }],
  ['ropa', (v) => v, (spec, r) => { spec.shirt = r.spec.shirt; }],
  ['pantalon', (v) => `pantalon ${v}`, (spec, r) => { spec.pants = r.spec.pants; }],
  ['zapatos', (v) => `zapatos ${v}`, (spec, r) => { spec.shoes = r.spec.shoes; }],
];

function cmdAvatarCompilarSpec(desc, out, opts) {
  // Texto/DSL -> spec v1 -> cuerpo 18×32. 100% offline y determinista: el
  // LLM traduce intención, el normalizador valida, el renderer pinta.
  const { normalizeAvatarDesc, parseAvatarDSL, validateAvatarSpec } = require('./avatar-spec.cjs');
  const { emitFullBodyProgram, runFlowProgram } = require('./flow-emit.cjs');
  let spec, warnings = [];
  if (opts.dsl) {
    // DSL directo (el formato que el pack enseña a los LLMs a escribir).
    let raw;
    try {
      raw = fs.readFileSync(path.resolve(expandTilde(opts.dsl)), 'utf8');
    } catch (e) {
      die(`no se lee --dsl ${opts.dsl} (${e && e.code ? e.code : 'ver error'})`);
    }
    const r = parseAvatarDSL(raw);
    if (!r.ok) {
      if (r.error.code === 'INVALID_ENUM') return dieInvalidSpec(r);
      die(`spec inválido: ${r.error.code} ${r.error.field}`);
    }
    spec = r.spec;
  } else if (desc && String(desc).trim()) {
    const r = normalizeAvatarDesc(String(desc));
    if (!r.ok) return dieInvalidSpec(r);
    spec = r.spec;
    warnings = r.warnings;
  } else {
    spec = normalizeAvatarDesc('').spec;
  }
  for (const [flag, synth, apply] of SPEC_PART_FLAGS) {
    if (!opts[flag]) continue;
    const r = normalizeAvatarDesc(synth(opts[flag]));
    if (!r.ok) return dieInvalidSpec(r);
    apply(spec, r);
    for (const w of r.warnings) warnings.push(`(${flag}) ${w}`);
  }
  const v = validateAvatarSpec(spec);
  if (!v.ok) {
    if (v.error.code === 'INVALID_ENUM') return dieInvalidSpec({ error: v.error });
    die(`spec inválido: ${v.error.code} ${v.error.field}`);
  }
  for (const w of warnings) console.log(st(`  ~ ${w}`, C.yellow));
  let program;
  try {
    program = emitFullBodyProgram(spec);
  } catch (e) {
    die(`no se pudo compilar: ${e.message}`);
  }
  try {
    runFlowProgram(program, out);
  } catch (e) {
    die(`motor spec: ${e.message}`);
  }
  // M11 18×32 sobre lo pintado (debe pasar; si falla es bug del emisor).
  const { verifyAvatar, decodePNG } = require('./lib-avatar.cjs');
  const vv = verifyAvatar(fs.readFileSync(out), { w: 18, h: 32, needAlpha: true, maxBytes: 512 * 1024 });
  if (!vv.ok) die(`motor spec: el pincel devolvió algo inválido (${vv.reason}). Repórtalo.`);
  const d = decodePNG(fs.readFileSync(out));
  let opaque = 0;
  for (let i = 3; i < d.rgba.length; i += 4) if (d.rgba[i] === 255) opaque++;
  console.log(st('  ✓ avatar compilado:', C.green, C.bold));
  console.log(`    ${out} (${d.w}x${d.h}, ${opaque} px opacos)`);
  console.log(`    receta: piel=${spec.skin} pelo=${spec.hair.style} ropa=${spec.shirt.style}`);
  return { path: out, recipe: spec, warnings };
}

// Regiones medidas en portraitArt.ts (NO copiar el sketch ilustrativo:
// ojos en y=9 por drawFace, cabeza x=4..13 por HX0/HX1, torso y>=19 por
// drawClothing). Un modelo que calcule "gafas en ojos" necesita estos.
const AVATAR_REGIONS = [
  'head    x=4..13 y=2..18',
  'eyes    x=5..6,10..11 y=9',
  'torso   x=4..13 y=19..27',
];

function cmdAvatarInspect(target) {
  if (!target) die('uso: munder avatar inspect <personaje|ruta.png>  (p. ej. pam, ./avatar.png)');
  const engine = loadAvatarEngine();
  let buf, w = 18, h = 28, title = target;
  const names = Object.keys(engine.AVATAR_RECIPES || {});
  if (names.includes(String(target).toLowerCase())) {
    const b = engine.composeAvatar(engine.AVATAR_RECIPES[String(target).toLowerCase()]);
    buf = Buffer.from(b);
    title = `${target} (receta del cast)`;
  } else {
    const p = path.resolve(expandTilde(target));
    if (!fs.existsSync(p)) {
      die(`ni personaje conocido ni archivo: ${target}. Personajes: ${names.join(', ') || 'engine sin cast?'}`);
    }
    const { decodePNG } = require('./lib-avatar.cjs');
    const d = decodePNG(fs.readFileSync(p));
    buf = Buffer.from(d.rgba);
    w = d.w; h = d.h;
    title = p;
  }
  // Leyenda: colores opacos distintos por frecuencia (máx 16), '.' = transparente.
  // Letras genéricas + hex (sin nombres inventados: el modelo ve estructura + regiones).
  const freq = new Map();
  for (let i = 0; i < buf.length; i += 4) {
    if (buf[i + 3] === 0) continue;
    const k = `${buf[i]},${buf[i + 1]},${buf[i + 2]}`;
    freq.set(k, (freq.get(k) || 0) + 1);
  }
  const LETTERS = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
  const legend = new Map();
  [...freq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 16).forEach(([k], i) => {
    legend.set(k, LETTERS[i] || '?');
  });
  const hex = (k) => '#' + k.split(',').map((n) => Number(n).toString(16).padStart(2, '0')).join('');
  console.log(`CANVAS ${w}x${h}  (${title})`);
  console.log('');
  for (let y = 0; y < h; y++) {
    let row = '';
    for (let x = 0; x < w; x++) {
      const o = (y * w + x) * 4;
      if (buf[o + 3] === 0) { row += '.'; continue; }
      const k = `${buf[o]},${buf[o + 1]},${buf[o + 2]}`;
      row += legend.get(k) || '?';
    }
    console.log(String(y).padStart(2, '0') + ' ' + row);
  }
  console.log('');
  for (const [k, L] of legend) console.log(`${L} = ${hex(k)}`);
  console.log('');
  for (const r of AVATAR_REGIONS) console.log(r);
}

