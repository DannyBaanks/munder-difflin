  const dest = path.join(avatarPendingDir(), `avatar-${Date.now().toString(36)}.png`);
  fs.writeFileSync(dest, outBuf);
  console.log(st(`  ✓ avatar válido instalado en pendientes:`, C.green, C.bold));
  console.log(`    ${dest} (${v.info.w}x${v.info.h}, ${v.info.bytes} bytes, con alpha)`);
}

async function cmdAvatar(args) {
  const [sub, ...rest] = args;
  if (sub === 'lienzo' || sub === 'canvas' || sub === 'blank') {
    return cmdAvatarLienzo(rest[0] ?? null);
  }
  if (sub === 'inspect' || sub === 'inspeccionar') {
    return cmdAvatarInspect(rest.find((a) => !a.startsWith('--')) ?? null);
  }
  if (sub === 'compilar' || sub === 'compile') {
    // Descripción = posicionales que NO sean flags ni valores de flags con valor.
    const VAL_FLAGS = new Set(['--salida', '--out', '-o', '--motor', '--endpoint', '--model', '--key-env', '--prompt', '--base-url', '--piel', '--pelo', '--ojos', '--ropa', '--pantalon', '--zapatos', '--dsl']);
    const descParts = [];
    for (let i = 0; i < rest.length; i++) {
      const a = rest[i];
      const eq = a.indexOf('=');
      const head = eq > 0 ? a.slice(0, eq) : a;
      if (VAL_FLAGS.has(head)) { if (eq < 0) i++; continue; }
      if (a.startsWith('-')) continue;
      descParts.push(a);
    }
    const desc = descParts.join(' ').trim();
    const getV = (name) => {
      const i = rest.indexOf(name);
      if (i >= 0) return rest[i + 1] ?? '';
      const eq = rest.find((a) => a.startsWith(name + '='));
      return eq ? eq.slice(name.length + 1) : null;
    };
    const cflags = rest.filter((a) => a.startsWith('--'));
    const dsl = getV('--dsl');
    let motor = getV('--motor');
    if (dsl && motor && motor !== 'spec') die(`--dsl solo vale con --motor spec (viene '${motor}').`);
    if (dsl) motor = 'spec';
    return cmdAvatarCompilar(desc || null, {
      salida: getV('--salida') || getV('--out') || getV('-o'),
      motor,
      endpoint: getV('--endpoint'),
      model: getV('--model'),
      keyEnv: getV('--key-env'),
      prompt: getV('--prompt'),
      baseUrl: getV('--base-url'),
      piel: getV('--piel'),
      pelo: getV('--pelo'),
      ojos: getV('--ojos'),
      ropa: getV('--ropa'),
      pantalon: getV('--pantalon'),
      zapatos: getV('--zapatos'),
      dsl,
      si: cflags.includes('--si') || cflags.includes('--yes'),
    });
  }
  if (sub === 'inyectar' || sub === 'inject') {
    const descParts = [];
    let slot = null, quitar = false, ver = false;
    for (let i = 0; i < rest.length; i++) {
      const a = rest[i];
      if (a === '--slot' || a.startsWith('--slot=')) {
        slot = a.startsWith('--slot=') ? a.slice('--slot='.length) : (rest[++i] ?? '');
      }
      else if (a === '--quitar') quitar = true;
      else if (a === '--ver') ver = true;
      else if (a.startsWith('-')) continue;
      else descParts.push(a);
    }
    return cmdAvatarInyectar(descParts.join(' ').trim() || null, { slot, quitar, ver });
  }
  if (sub === 'editar' || sub === 'edit') {
    const png = rest.find((a) => !a.startsWith('--')) ?? null;
    const flags = rest.filter((a) => a.startsWith('--'));
    const val = (name) => {
      const i = rest.indexOf(name);
      if (i >= 0) return rest[i + 1] ?? '';
      const eq = rest.find((a) => a.startsWith(name + '='));
      return eq ? eq.slice(name.length + 1) : null;
    };
    return cmdAvatarEditar(png, {
      endpoint: val('--endpoint'),
      model: val('--model'),
      keyEnv: val('--key-env'),
      prompt: val('--prompt'),
      baseUrl: val('--base-url'),
      si: flags.includes('--si') || flags.includes('--yes'),
    });
  }
  // Sin subcomando (o en menú): selector lienzo/compilar/inyectar/inspect/editar.
  if (!IS_TTY) die('uso: munder avatar lienzo [salida] | munder avatar compilar "desc" [--motor local|modelo|flow|spec] [--salida] [--piel|--pelo|--ojos|--ropa|--pantalon|--zapatos <valor>] [--dsl <spec.txt>] | munder avatar inyectar "desc" --slot <nombre|auto> [--quitar|--ver] | munder avatar editar <png> --endpoint <id> --model <id> [--prompt "..."]');
  const i = await select('¿Avatar qué hacemos?', [
    { label: 'Lienzo en blanco (18×28 transparente)', value: 'lienzo' },
    { label: 'Compilar desde texto (local/modelo/flow/spec)', value: 'compilar' },
    { label: 'Inyectar al piso (placeholder persistente)', value: 'inyectar' },
    { label: 'Inspeccionar (matriz para LLMs)', value: 'inspect' },
    { label: 'Editar un PNG con el modelo', value: 'editar' },
  ]);
  if (i < 0) { say('cancelado.'); return; }
  if (i === 0) {
    const out = (await ask('  Salida (vacío = ./avatar-lienzo-18x28.png): ')).trim() || null;
    return cmdAvatarLienzo(out);
  }
  if (i === 1) {
    const mi = await select('¿Con qué motor compilamos?', [
      { label: 'local (engine procedural, sin red)', value: 'local' },
      { label: 'modelo (GPT con engine, images/edits)', value: 'modelo' },
      { label: 'flow (pincel determinista, sin clave)', value: 'flow' },
      { label: 'spec (paramétrico texto→spec→18×32, sin clave)', value: 'spec' },
    ]);
    if (mi < 0) { say('cancelado.'); return; }
    const motor = ['local', 'modelo', 'flow', 'spec'][mi];
    const mo = { salida: null, motor };
    let desc = '';
    if (motor === 'spec') {
      // Selector guiado por partes: básicos ligados a pantones + PANTONE:
      // libre. Vacío = se queda lo de la descripción o la base.
      desc = (await ask('  Describe (vacío si vas a elegir por partes): ')).trim();
      for (const [flag, ejemplo] of [
        ['piel', 'clara/morena/marrón/oscura o PANTONE: …'],
        ['pelo', 'corto castaño, largo rubio, …'],
        ['ojos', 'verdes, cafés, …'],
        ['ropa', 'traje azul, blusa rosa, …'],
        ['pantalon', 'azul, negro, …'],
        ['zapatos', 'negros, blancos, …'],
      ]) {
        const v = (await ask(`  ${flag} (${ejemplo}) [vacío=saltar]: `)).trim();
        if (v) mo[flag] = v;
      }
      if (!desc && !['piel', 'pelo', 'ojos', 'ropa', 'pantalon', 'zapatos'].some((k) => mo[k])) {
        say('cancelado: sin descripción ni partes.'); return;
      }
    } else {
      desc = (await ask('  Describe (p. ej. piel morena, pelo negro corto, camisa azul, gafas): ')).trim();
      if (!desc) { say('cancelado.'); return; }
    }
    const out = (await ask('  Salida (vacío = ./avatar-18x28-<fecha>.png): ')).trim() || null;
    mo.salida = out;
    if (motor === 'modelo') {
      const ei = await select('¿Contra qué endpoint edita?', ENDPOINTS.map((e) => ({
        label: e.label, hint: `${e.keyEnv} · ${e.wire}`, value: e.id,
      })));
      if (ei < 0) { say('cancelado.'); return; }
      mo.endpoint = ENDPOINTS[ei].id;
      mo.model = (await ask(`  Modelo de imagen en ${ENDPOINTS[ei].label}: `)).trim();
      if (!mo.model) { say('sin modelo, cancelado.'); return; }
    }
    return cmdAvatarCompilar(desc || null, mo);
  }
  if (i === 2) {
    const desc = (await ask('  Describe (p. ej. piel morena, pelo castaño largo, blusa rosa): ')).trim();
    if (!desc) { say('cancelado.'); return; }
    const slot = (await ask("  Slot (nombre del cast, 'auto' o vacío=auto): ")).trim() || 'auto';
    return cmdAvatarInyectar(desc, { slot, quitar: false, ver: false });
  }
  if (i === 3) {
    const target = (await ask('  Personaje o PNG (p. ej. pam, ./avatar.png): ')).trim();
    if (!target) { say('cancelado.'); return; }
    return cmdAvatarInspect(target);
  }
  const png = (await ask('  PNG a editar: ')).trim();
  if (!png) { say('cancelado.'); return; }
  const ei = await select('¿Contra qué endpoint edita?', ENDPOINTS.map((e) => ({
    label: e.label, hint: `${e.keyEnv} · ${e.wire}`, value: e.id,
  })));
  if (ei < 0) { say('cancelado.'); return; }
  const ep = ENDPOINTS[ei];
  const model = (await ask(`  Modelo de imagen en ${ep.label}: `)).trim();
  if (!model) { say('sin modelo, cancelado.'); return; }
  return cmdAvatarEditar(png, { endpoint: ep.id, model });
}

