// ─── avatar inyectar: placeholder persistente ("cuerpo prestado") ────────────
// Espejo de OFFICE_CAST (src/renderer/src/scene/office/cast.ts). Si el roster
// cambia, actualizar. Guarda en userData/avatar-overrides.json; la app lo lee
// al montar el piso (avatar:getOverrides) y le inyecta tu receta al slot.
const OFFICE_CAST_SLOTS = ['michael', 'jim', 'pam', 'dwight', 'kevin', 'angela',
  'oscar', 'stanley', 'phyllis', 'andy', 'kelly', 'ryan', 'toby', 'creed', 'meredith'];
function overridesFile() { return path.join(userDataDir(), 'avatar-overrides.json'); }
function readOverrides() {
  try {
    const raw = JSON.parse(fs.readFileSync(overridesFile(), 'utf8'));
    const o = raw && typeof raw === 'object' ? (raw.overrides ?? {}) : {};
    if (!o || typeof o !== 'object' || Array.isArray(o)) return {};
    return o;
  } catch { return {}; }
}
function writeOverrides(o) {
  fs.mkdirSync(userDataDir(), { recursive: true });
  fs.writeFileSync(overridesFile(),
    JSON.stringify({ version: 1, actualizado: new Date().toISOString(), overrides: o }, null, 2));
}
// Primer slot libre según el canal vivo. Misma inferencia que el renderer
// (useHive: nombre→cast, resto→jim) + lo ya guardado en overrides.
async function firstFreeSlot() {
  const used = new Set(Object.keys(readOverrides()));
  const r = readChannelCfg();
  if (r && !r.corrupt) {
    const resp = await channelCall('GET', { port: r.cfg.port, path: '/sesion' }, undefined, r.cfg.token)
      .catch(() => null);
    const agents = resp && resp.status === 200 && resp.body && Array.isArray(resp.body.agents)
      ? resp.body.agents : null;
    if (!agents) return null;
    for (const a of agents) {
      // Inferencia exacta del renderer (useHive): nombre→cast, resto→jim.
      const nm = String((a && a.name) || (a && a.id) || '').trim().toLowerCase();
      used.add(OFFICE_CAST_SLOTS.includes(nm) ? nm : 'jim');
    }
  } else if (!r) {
    return null;
  }
  for (const s of OFFICE_CAST_SLOTS) {
    if (s === 'michael' || used.has(s)) continue;
    return s;
  }
  return null;
}
async function cmdAvatarInyectar(desc, opts) {
  if (opts.ver) {
    const o = readOverrides();
    const keys = Object.keys(o);
    if (!keys.length) { console.log('munder: sin overrides (munder avatar inyectar "desc" --slot <nombre|auto>).'); return; }
    for (const k of keys) console.log(`  ${k}: ${(o[k] && o[k].desc) || '(sin desc)'}`);
    return;
  }
  const slotArg = String(opts.slot || '').trim().toLowerCase();
  if (opts.quitar) {
    if (!slotArg) die('uso: munder avatar inyectar --quitar --slot <nombre>');
    const o = readOverrides();
    if (!o[slotArg]) die(`no hay override en '${slotArg}'.`);
    delete o[slotArg];
    writeOverrides(o);
    console.log(`munder: override de '${slotArg}' eliminado. Reinicia la app para verlo.`);
    return;
  }
  if (!desc || !desc.trim()) die('uso: munder avatar inyectar "piel morena, ..." --slot <nombre|auto>');
  const engine = loadAvatarEngine();
  const { compileAvatar } = require('./lib-avatar.cjs');
  let compiled;
  try {
    compiled = compileAvatar(engine, String(desc));
  } catch (e) {
    die(`no se pudo compilar: ${e.message}`);
  }
  for (const w of compiled.warnings) console.log(st(`  ~ ${w}`, C.yellow));
  let slot = slotArg;
  if (!slot || slot === 'auto') {
    slot = await firstFreeSlot();
    if (!slot) die('sin canal para auto (¿la app está corriendo?) o piso lleno: pasa --slot <nombre>.');
    console.log(`  slot auto: ${slot}`);
  }
  if (slot === 'michael') die("michael es del GOD, no se presta. Usa otro slot o 'auto'.");
  if (!OFFICE_CAST_SLOTS.includes(slot)) {
    die(`slot desconocido '${slot}'. Opciones: ${OFFICE_CAST_SLOTS.filter((s) => s !== 'michael').join(', ')}`);
  }
  const recipe = JSON.parse(JSON.stringify(compiled.recipe));
  const o = readOverrides();
  o[slot] = { recipe, desc: String(desc).trim(), actualizado: new Date().toISOString() };
  writeOverrides(o);
  console.log(st(`  ✓ inyectado en '${slot}':`, C.green, C.bold));
  console.log(`    receta: piel=${recipe.skin} pelo=${recipe.hair} ropa=${recipe.cloth}`);
  console.log(st('  Reinicia la app para verlo (el override aplica al montar el piso).', C.dim));
  console.log(st(`  Arma su worker con character='${slot}' (munder sesion armar o Add agent).`, C.dim));
}

