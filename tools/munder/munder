#!/usr/bin/env node
'use strict';
/**
 * munder — CLI de control dev para Munder Difflin (v3 interactivo).
 *
 * Fuente de verdad: tools/munder/munder (dentro de este repo).
 * Instala: ln -sf "$PWD/tools/munder/munder" ~/.local/bin/munder
 * Uso: munder [comando] · sin args abre el menú interactivo (si hay TTY).
 *
 * HEREDADO del launcher bash 2026-09-21 (conservado en munder.bash-legacy):
 * FIX freeze "Detenido": lanzar `npm run dev` adjunto al job control del shell
 * hace que, al arrancar node-pty los agentes, el árbol reciba SIGTSTP y la app
 * se congela (state T, "[N]+ Detenido", ventana freezada). Fix probado:
 * setsid + stdio a archivo + despegado del tty. No usar --fg salvo debug.
 * NOTA singleton: userData (~/.config/munder-difflin) COMPARTIDO entre dev y
 * build compilado. No ambos a la vez: la 2da instancia muere (second-instance).
 * NOTA sandbox: el chrome-sandbox del checkout no es root:root 4755, así que
 * el dev corre con ELECTRON_DISABLE_SANDBOX=1 (igual que el launcher viejo).
 *
 * Sin dependencias (solo builtins de node) para correr en máquina recién
 * instalada. Linux-first (setsid, pgrep, ss); el menú interactivo exige TTY
 * en stdin+stdout — sin TTY se imprime la ayuda y no se cuelga nada.
 */

const { spawn, spawnSync, execFileSync } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const readline = require('node:readline');
const { chatearPersonaje } = require('./lib-personaje.cjs');
const { blankCanvas, decodePNG, verifyAvatar, editImageEndpoint } = require('./lib-avatar.cjs');

// ─── config ────────────────────────────────────────────────────────────────
const MUNDER_DIR = process.env.MUNDER_DIR || path.resolve(__dirname, '..', '..');
const STATE_DIR = process.env.MUNDER_STATE_DIR || path.join(process.env.XDG_STATE_HOME || path.join(os.homedir(), '.local', 'state'), 'munder');
const PID_FILE = path.join(STATE_DIR, 'munder-dev.pid');
const LATEST_LOG = path.join(STATE_DIR, 'latest.log');
// Patrón estricto: solo el dev de ESTE checkout (nunca los agentes hive en bun).
const PATTERN = path.basename(MUNDER_DIR) + '/node_modules';
const IS_TTY = !!process.stdin.isTTY && !!process.stdout.isTTY;
const USE_COLOR = IS_TTY && !process.env.NO_COLOR;

// ─── estilo (ANSI mínimo, solo con TTY) ─────────────────────────────────────
const C = {
  reset: '\x1b[0m', bold: '\x1b[1m', dim: '\x1b[2m',
  cyan: '\x1b[36m', green: '\x1b[32m', yellow: '\x1b[33m',
  red: '\x1b[31m', inverse: '\x1b[7m', hide: '\x1b[?25l', show: '\x1b[?25l'.replace('?25l', '?25h'),
};
const st = (s, ...codes) => (USE_COLOR && codes.length ? codes.join('') + s + C.reset : s);
const say = (m) => console.log(`munder: ${m}`);
const die = (m) => { console.error(`munder: ${m}`); process.exit(1); };

const BANNER = st('▚ MUNDER', C.bold, C.cyan) + st('  dev control', C.dim);

// ─── procesos ──────────────────────────────────────────────────────────────
function pids() {
  try {
    const r = spawnSync('pgrep', ['-f', PATTERN], { encoding: 'utf8' });
    return (r.stdout || '').split('\n').map((s) => s.trim()).filter(Boolean);
  } catch { return []; }
}
function alive(pid) {
  try { process.kill(Number(pid), 0); return true; } catch { return false; }
}
function which(bin) {
  const dirs = (process.env.PATH || '').split(path.delimiter).filter(Boolean);
  for (const d of dirs) {
    const p = path.join(d, bin);
    try { fs.accessSync(p, fs.constants.X_OK); return p; } catch { /* sigue */ }
  }
  return null;
}
function portListening(port) {
  try {
    const r = spawnSync('ss', ['-ltn'], { encoding: 'utf8', timeout: 3000 });
    return (r.stdout || '').split('\n').some((l) => l.includes(`:${port} `));
  } catch { return false; }
}

// ─── spinner (una línea, se limpia solo) ────────────────────────────────────
async function spin(msg, ms, doneEarly) {
  if (!IS_TTY) { await new Promise((r) => setTimeout(r, ms)); return; }
  const frames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
  let i = 0;
  const t0 = Date.now();
  process.stdout.write(C.hide);
  try {
    for (;;) {
      const el = Date.now() - t0;
      if (el >= ms || (doneEarly && doneEarly())) break;
      process.stdout.write(`\r${st(frames[i++ % frames.length], C.cyan)} ${msg}`);
      await new Promise((r) => setTimeout(r, 120));
    }
  } finally {
    process.stdout.write('\r\x1b[0K' + C.show);
  }
}

// ─── selector interactivo (flechas + Enter, sin ser TUI) ────────────────────
function select(message, choices) {
  // choices: [{ label, hint?, value }]. Resuelve índice o -1 (Esc/q/Ctrl-C sale 130).
  return new Promise((resolve) => {
    const stdin = process.stdin;
    let idx = 0, done = false, buf = '', escTimer = null;
    const lines = () => choices.length + 2; // opciones + pie de ayuda
    const cleanup = () => {
      stdin.removeListener('data', onData);
      try { if (stdin.isTTY) stdin.setRawMode(false); } catch { /* noop */ }
      try { stdin.pause(); } catch { /* noop */ }
      process.stdout.write(C.show);
      if (escTimer) clearTimeout(escTimer);
    };
    const finish = (v, code) => {
      if (done) return; done = true;
      // Los bytes que llegaron en el mismo chunk DESPUÉS de la tecla decisiva
      // pertenecen al SIGUIENTE prompt: se devuelven al stream para que los
      // lea quien sigue (otro select, readline o askHidden). Sin esto, una
      // ráfaga (pegar texto, tests por pty) pierde todo menos la primera tecla.
      const rest = buf;
      buf = '';
      cleanup();
      if (rest.length) { try { stdin.unshift(Buffer.from(rest, 'utf8')); } catch { /* noop */ } }
      if (typeof code === 'number') process.exitCode = code;
      resolve(v);
    };
    const render = (first) => {
      let out = '';
      if (!first) out += `\x1b[${lines()}A`;
      out += `${st(message, C.bold)}\n`;
      choices.forEach((c, i) => {
        const mark = i === idx ? st('❯', C.cyan, C.bold) : ' ';
        const lab = i === idx ? st(c.label, C.inverse) : c.label;
        const hint = c.hint ? st(`  ${c.hint}`, C.dim) : '';
        out += `${mark} ${lab}${hint}\n`;
      });
      out += st('↑↓ navegar · Enter elegir · Esc salir', C.dim) + '\n';
      out += '\x1b[0J';
      process.stdout.write(out);
    };
    const move = (d) => { idx = (idx + d + choices.length) % choices.length; render(false); };
    const flushEsc = () => { escTimer = null; finish(-1); };
    const onData = (chunk) => {
      buf += chunk.toString('utf8');
      for (;;) {
        if (buf.length === 0) return;
        if (buf[0] === '\u0003') { finish(-1, 130); process.exit(130); return; } // Ctrl-C
        if (buf.startsWith('\x1b[')) {
          if (buf.length < 3) return; // secuencia incompleta: espera más bytes
          const code = buf[2];
          buf = buf.slice(3);
          if (code === 'A') move(-1);
          else if (code === 'B') move(1);
          continue;
        }
        if (buf[0] === '\x1b') { buf = buf.slice(1); if (escTimer) clearTimeout(escTimer); escTimer = setTimeout(flushEsc, 60); continue; }
        const ch = buf[0]; buf = buf.slice(1);
        if (ch === '\r' || ch === '\n') { finish(idx); return; }
        if (ch === 'q' || ch === 'Q') { finish(-1); return; }
        const n = parseInt(ch, 10);
        if (n >= 1 && n <= choices.length) { finish(n - 1); return; }
      }
    };
    try { stdin.setRawMode(true); } catch { resolve(-1); return; }
    stdin.resume();
    stdin.on('data', onData);
    process.stdout.write(C.hide);
    render(true);
  });
}

function ask(question) {
  return new Promise((resolve) => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    rl.question(question, (a) => { rl.close(); resolve(a); });
  });
}

// ─── carpetas: SIEMPRE ventana nativa primero ─────────────────────────────────
// Regla del dueño: nunca pedir que escriban rutas a mano si se puede invocar
// una ventana. zenity (GTK) si hay DISPLAY; si no, prompt terminal (último
// recurso, avisado). Devuelve path, null si cancela, o 'UNAVAILABLE' si no hay
// cómo mostrar ventana (el llamador cae a prompt avisando).
function pickFolderWindow(title, initialDir) {
  if (!process.env.DISPLAY || !which('zenity')) return 'UNAVAILABLE';
  try {
    const args = ['--file-selection', '--directory', `--title=${title}`];
    if (initialDir) args.push(`--filename=${initialDir.replace(/\/+$/, '')}/`);
    const r = spawnSync('zenity', args, { encoding: 'utf8', timeout: 120000 });
    if (r.status !== 0) return null;
    const p = (r.stdout || '').trim();
    return p || null;
  } catch { return null; }
}

/** Pide una carpeta EXISTENTE: ventana nativa primero, prompt solo sin GUI.
 *  Expande ~, valida que exista y sea dir. null = el usuario canceló. */
async function pedirCarpeta(titulo, preguntaPrompt, dirInicial) {
  const win = pickFolderWindow(titulo, dirInicial);
  if (win !== 'UNAVAILABLE') return win; // path o null (canceló)
  console.log(st('  (sin ventana disponible: escribe la ruta a mano)', C.dim));
  const raw = (await ask(`  ${preguntaPrompt}: `)).trim();
  if (!raw) return null;
  const p = expandTilde(raw);
  if (!fs.existsSync(p) || !fs.statSync(p).isDirectory()) {
    console.log(st(`  no existe o no es carpeta: ${p}`, C.yellow));
    return null;
  }
  return p;
}

// ─── validación nombre harness (misma regla que isValidHarnessFolderName) ────
const HARNESS_NAME_MAX = 128;
function validHarnessName(name) {
  if (typeof name !== 'string') return { ok: false, error: 'nombre inválido' };
  const t = name.trim();
  if (!t) return { ok: false, error: 'escribe un nombre de carpeta' };
  if (t.length > HARNESS_NAME_MAX) return { ok: false, error: `máximo ${HARNESS_NAME_MAX} caracteres` };
  if (t === '.' || t === '..') return { ok: false, error: 'nombre reservado' };
  if (/[/\\\0]/.test(t)) return { ok: false, error: 'el nombre no puede llevar slashes' };
  if (/^(con|prn|aux|nul|com[1-9]|lpt[1-9])(\.|$)/i.test(t)) return { ok: false, error: 'reservado por Windows' };
  return { ok: true, name: t };
}
function expandTilde(p) {
  return p === '~' ? os.homedir() : p.startsWith('~/') ? path.join(os.homedir(), p.slice(2)) : p;
}

// ─── .gitignore del harness (misma lista que ensureHarnessGitignore) ─────────
const HARNESS_GITIGNORE = ['hive/', 'palace/', 'roster.json', 'roster-backups/'];
const GITIGNORE_MARK = '# munder-difflin harness runtime (auto-generated — safe to edit)';
function ensureHarnessGitignore(dir) {
  const p = path.join(dir, '.gitignore');
  let cur = '';
  try { if (fs.existsSync(p)) cur = fs.readFileSync(p, 'utf8'); } catch { /* sigue */ }
  const have = new Set(cur.split('\n').map((l) => l.trim().replace(/\/+$/, '')).filter(Boolean));
  const missing = HARNESS_GITIGNORE.filter((e) => !have.has(e.replace(/\/+$/, '')));
  if (!missing.length) return;
  const block = ['', GITIGNORE_MARK, ...missing, ''].join('\n');
  fs.writeFileSync(p, cur + (cur && !cur.endsWith('\n') ? '\n' : '') + block, 'utf8');
}

// ─── comandos ────────────────────────────────────────────────────────────────
