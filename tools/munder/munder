function detectCLIs() {
  // Solo instalados: binario resoluble por PATH o dirs candidatos del repo.
  const pathDirs = (process.env.PATH || '').split(path.delimiter).filter(Boolean);
  const home = os.homedir();
  const extra = [...CANDIDATE_DIRS, ...HOME_CANDIDATE_DIRS.map((d) => path.join(home, d))];
  const out = [];
  for (const c of CLI_DETECT) {
    let found = null;
    outer:
    for (const b of c.bins) {
      for (const d of [...pathDirs, ...extra]) {
        const p = path.join(d, b);
        try { fs.accessSync(p, fs.constants.X_OK); found = p; break outer; } catch { /* sigue */ }
      }
    }
    if (!found) continue;
    const keys = (c.keyEnvs || []).filter((e) => !!process.env[e]);
    const auths = (c.authFiles || []).filter((f) => { try { return fs.existsSync(path.join(home, f)); } catch { return false; } });
    out.push({ ...c, path: found, keysPresent: keys, authPresent: auths });
  }
  return out;
}

