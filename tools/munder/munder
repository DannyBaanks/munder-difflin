function cmdLogs(args) {
  let n = 100, follow = false;
  for (const a of args) {
    if (a === '-f' || a === '--follow') follow = true;
    else if (/^\d+$/.test(a)) n = Number(a);
    else die(`logs: '${a}' no es número. Uso: munder logs [N] [-f]`);
  }
  if (!fs.existsSync(LATEST_LOG)) die(`sin log en ${LATEST_LOG} (¿nunca se arrancó?)`);
  if (!follow) {
    console.log(fs.readFileSync(LATEST_LOG, 'utf8').trimEnd().split('\n').slice(-n).join('\n'));
    return;
  }
  const tail = spawn('tail', ['-n', String(n), '-f', LATEST_LOG], { stdio: 'inherit' });
  tail.on('exit', (c) => process.exit(c ?? 0));
}

function startDev() {
  // Lanza y verifica vivo a los 2s (igual que el launcher bash).
  const runLog = path.join(STATE_DIR, `run-${new Date().toISOString().slice(0, 19).replace(/[-:]/g, '').replace('T', 'T')}.log`);
  fs.mkdirSync(STATE_DIR, { recursive: true });
  fs.symlinkSync(runLog, LATEST_LOG + '.tmp');
  fs.renameSync(LATEST_LOG + '.tmp', LATEST_LOG);
  // Rotación mínima: conserva las últimas 20 corridas.
  try {
    const runs = fs.readdirSync(STATE_DIR).filter((f) => /^run-.*\.log$/.test(f))
      .map((f) => path.join(STATE_DIR, f))
      .sort((a, b) => fs.statSync(b).mtimeMs - fs.statSync(a).mtimeMs);
    for (const old of runs.slice(20)) fs.unlinkSync(old);
  } catch { /* mejor esfuerzo */ }
  say('lanzando npm run dev despegado (sin terminal de control)');
  say(`log de esta corrida: ${runLog}`);
  const logFd = fs.openSync(runLog, 'a');
  const child = spawn('npm', ['run', 'dev'], {
    cwd: MUNDER_DIR, detached: true, stdio: ['ignore', logFd, logFd],
    env: { ...process.env, ELECTRON_DISABLE_SANDBOX: '1' },
  });
  child.unref();
  try { fs.closeSync(logFd); } catch { /* el hijo la heredó */ }
  fs.writeFileSync(PID_FILE, String(child.pid));
  return child.pid;
}

async function cmdStart(fg) {
  cmdCheckSilent();
  if (pids().length) die("ya está corriendo. Usa 'munder status' o 'munder stop' primero.");
  try {
    const old = fs.existsSync(PID_FILE) ? fs.readFileSync(PID_FILE, 'utf8').trim() : '';
    if (old && alive(old)) die(`el pid file dice que ya corre (pid ${old}). Si es huérfano, borra ${PID_FILE}.`);
  } catch (e) { if (e.code !== 'ENOENT') { /* pid ilegible: se sigue */ } }
  try { if (fs.existsSync(PID_FILE)) fs.unlinkSync(PID_FILE); } catch { /* noop */ }
  fs.mkdirSync(STATE_DIR, { recursive: true });
  if (fg) {
    say('modo adjunto (--fg): ADVERTENCIA — puede congelarse (SIGTSTP del job control). Solo debug.');
    process.env.ELECTRON_DISABLE_SANDBOX = '1';
    const { spawnSync: ss } = require('node:child_process');
    const r = ss('npm', ['run', 'dev'], { cwd: MUNDER_DIR, stdio: 'inherit', env: process.env });
    process.exit(r.status ?? 1);
  }
  const pid = startDev();
  await spin('arrancando dev…', 2000);
  if (!alive(pid) && !pids().length) {
    say('el proceso dev murió al arrancar; últimas líneas del log:');
    try {
      console.error(fs.readFileSync(LATEST_LOG, 'utf8').trimEnd().split('\n').slice(-30).join('\n'));
    } catch { /* sin log */ }
    try { fs.unlinkSync(PID_FILE); } catch { /* noop */ }
    process.exit(1);
  }
  say(`en marcha (pid ${pid})`);
  say('log: munder logs -f | parar: munder stop');
}

function cmdCheckSilent() {
  if (!fs.existsSync(MUNDER_DIR)) die(`no existe MUNDER_DIR=${MUNDER_DIR}`);
  if (!fs.existsSync(path.join(MUNDER_DIR, 'package.json'))) die(`package.json no encontrado en ${MUNDER_DIR}`);
  if (!fs.existsSync(path.join(MUNDER_DIR, 'node_modules'))) die(`node_modules no encontrado. Ejecuta npm install en ${MUNDER_DIR}`);
}

async function cmdStop() {
  try {
    if (fs.existsSync(PID_FILE)) {
      const lp = fs.readFileSync(PID_FILE, 'utf8').trim();
      if (lp && alive(lp)) { console.log(`munder: TERM a launcher ${lp}`); try { process.kill(Number(lp)); } catch { /* noop */ } }
    }
  } catch { /* noop */ }
  let list = pids();
  if (!list.length) {
    console.log('munder: ya estaba parado.');
    try { fs.unlinkSync(PID_FILE); } catch { /* noop */ }
    await pruneChannelOrphan();
    return;
  }
  console.log(`munder: TERM a: ${list.join(' ')}`);
  for (const p of list) { try { process.kill(Number(p)); } catch { /* noop */ } }
  const t0 = Date.now();
  while (pids().length && Date.now() - t0 < 5000) await new Promise((r) => setTimeout(r, 250));
  list = pids();
  if (list.length) {
    console.log(`munder: KILL a: ${list.join(' ')}`);
    for (const p of list) { try { process.kill(Number(p), 9); } catch { /* noop */ } }
    await new Promise((r) => setTimeout(r, 1500));
  }
  list = pids();
  if (list.length) { console.error(`munder: ATENCION, siguen vivos: ${list.join(' ')}`); process.exit(1); }
  try { fs.unlinkSync(PID_FILE); } catch { /* noop */ }
  await pruneChannelOrphan();
  console.log('munder: parado.');
}

