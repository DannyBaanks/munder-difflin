// Wizard proveedor/modelo/connect-style. Flujo:
// CLI instalado -> endpoint (top-10, con ●/○ por key detectada) -> modelo
// (del catálogo; ●/○ por key) -> si falta key: sudo+disclaimer+pegar (solo
// al auth propio del CLI) o instrucciones -> chat IA opcional -> review ->
// armar (confirmado) o comando.
async function cmdSesionProveedor(args) {
  const getFlag = (ns) => flagVal(args, ns);
  const catalog = readModelCatalog();
  if (!IS_TTY && !getFlag(['--cli', '--comando'])) {
    die('sin TTY: usa flags. Uso: munder sesion proveedor --cli <id> [--endpoint <id>] [--model <slug>]');
  }
  // 1) CLI.
  const detected = detectCLIs();
  let cliId = getFlag(['--cli']);
  if (!cliId) {
    if (!detected.length) die('no detecté ningún CLI instalado (¿están en tu PATH?). Revisa con: which claude codex gemini');
    const i = await select('¿Con qué CLI trabajamos?', [
      ...detected.map((d) => ({
        label: d.id,
        hint: `${d.path}${d.keysPresent.length || d.authPresent.length ? '  ● key' : '  ○ sin key'}`,
        value: d.id,
      })),
      { label: 'Comando manual…', hint: 'como hasta ahora', value: '__manual__' },
    ]);
    if (i < 0) { say('cancelado.'); return; }
    const picked = [ ...detected.map((d) => d.id), '__manual__'][i];
    if (picked === '__manual__') return await cmdSesionArmar([]);
    cliId = picked;
  }
  const cli = CLI_DETECT.find((c) => c.id === cliId) || { id: cliId, bins: [cliId], keyEnvs: [], authFiles: [], login: 'login propio del CLI' };
  // 2) Endpoint (top-10 OpenAI-compatibles; el CLI fijo trae el suyo).
  let endpointId = getFlag(['--endpoint']);
  let endpoint = endpointId ? ENDPOINTS.find((e) => e.id === endpointId) : null;
  if (endpointId && !endpoint) die(`endpoint desconocido '${endpointId}'. Opciones: ${ENDPOINTS.map((e) => e.id).join(', ')}`);
  if (!endpoint) {
    const i = await select(`¿Contra qué endpoint corre ${cliId}?`, [
      { label: 'El CLI trae el suyo', hint: 'login/auth propio', value: '__propio__' },
      ...ENDPOINTS.map((e) => ({
        label: e.label,
        hint: `${process.env[e.keyEnv] ? '●' : '○'} ${e.keyEnv} · ${e.wire}`,
        value: e.id,
      })),
    ]);
    if (i < 0) { say('cancelado.'); return; }
    const ids = ['__propio__', ...ENDPOINTS.map((e) => e.id)];
    endpoint = ids[i] === '__propio__' ? null : ENDPOINTS.find((e) => e.id === ids[i]);
  }
  // 3) Modelo (del catálogo del checkout; ●/○ por key del endpoint o del CLI).
  const catalogModels = modelsForCli(catalog, cliId);
  let model = getFlag(['--model', '--modelo', '-m']);
  const keyFor = (m) => {
    if (endpoint) return endpoint.keyEnv;
    const slugKey = m && keyForModelSlug(m);
    if (slugKey) return slugKey;
    const ce = (cli.keyEnvs || [])[0] || null;
    return ce;
  };
  if (!model) {
    const choices = catalogModels.map((m) => {
      const k = keyFor(m.id);
      const has = k ? !!process.env[k] : false;
      return { label: m.label, hint: `${m.id}${has ? '  ● ' + k : k ? '  ○ ' + k : ''}`, value: m.id };
    });
    choices.push({ label: 'Escribir modelo a mano…', hint: '', value: '__free__' });
    const i = await select(`¿Qué modelo usa ${cliId}?`, choices);
    if (i < 0) { say('cancelado.'); return; }
    model = i < catalogModels.length ? catalogModels[i].id : null;
    if (!model) model = (await ask('  Slug del modelo: ')).trim();
    if (!model) die('sin modelo, cancelado.');
  }
  const needKey = keyFor(model) || (endpoint ? endpoint.keyEnv : (cli.keyEnvs || [])[0] || null);
  const hasKey = needKey ? !!process.env[needKey] : true;
  // 4) Si falta key: sudo + disclaimer + pegar (solo al auth del CLI) o instrucciones.
  // Sin TTY no se puede pedir sudo ni leer en oculto: se avisa y se sigue (el
  // agente fallará al correr por auth, pero armar no exige key presente).
  let linkedWhere = null;
  let pastedKey = null; // solo memoria de esta corrida: alimenta el chat IA si lo pides
  if (!hasKey && needKey) {
    console.log('');
    console.log(st(`  Falta ${needKey}. Para vincularla sin guardar nada en munder:`, C.bold));
    printDisclaimer();
    if (!IS_TTY) {
      console.log(st('  Sin TTY no puedo pedir sudo ni leer la key: sigo sin vincular (expórtala tú).', C.yellow));
    } else {
      console.log('  Verificando que eres tú (sudo, no ejecuta nada como root)…');
      if (!sudoGate()) {
        console.log(st('  sudo no autorizado: sigo sin vincular. Nada se tocó.', C.yellow));
      } else {
        const key = await askHidden(`  Pega ${needKey} (no se muestra): `);
        if (!key) { say('vacía: sigo sin vincular.'); }
        else {
          pastedKey = key; // memoria volátil: solo se usa si abres el chat abajo
          const r = linkKeyToCli(cliId, key);
          if (r.ok) { linkedWhere = r.where; console.log(st(`  ✓ vinculada en ${r.where} (+ .bak-munder de respaldo)`, C.green)); }
          else if (r.manual) console.log(st(`  No la guardé en ningún lado. Hazlo así: ${r.manual}`, C.yellow));
          else console.log(st(`  No se pudo vincular (${r.error}). Nada quedó a medias: la key no está en ningún archivo de munder.`, C.yellow));
        }
      }
    }
  }
  // 4b) Chat IA para crear el personaje (opcional). Solo con endpoint
  // openai-compatible + key en memoria (pegada arriba o de env; jamás de
  // archivos) + modelo resuelto. Sin TTY no se ofrece (es conversacional).
  let personaje = null;
  const chatKey = pastedKey || ((needKey && process.env[needKey]) || null);
  const chatOk = endpoint && endpoint.wire === 'openai-compatible' && chatKey && model;
  if (IS_TTY && chatOk) {
    const wc = await select('¿Creamos el personaje chateando con IA?', [
      { label: 'Sí, abrir chat', value: 'go' },
      { label: 'No, seguir normal', value: 'no' },
    ]);
    if (wc === 0) personaje = await chatearPersonaje(endpoint, model, chatKey, chatIO);
    else if (wc < 0) { say('seguimos sin chat.'); }
  } else if (IS_TTY && endpoint && endpoint.wire !== 'openai-compatible') {
    console.log(st('  (chat IA disponible solo para endpoints openai-compatibles por ahora)', C.dim));
  }
  let personajeAvatar = null;
  const slugAvatar = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'sin-nombre';
  if (personaje) {
    // Pendiente para el pipeline de avatares (M8): JSON en el state local
    // (fuera de repos y de roster; la persona/avatar aún no tienen canal).
    try {
      const dir = path.join(STATE_DIR, 'personajes');
      fs.mkdirSync(dir, { recursive: true });
      const slug = slugAvatar(personaje.nombre);
      const pjPath = path.join(dir, `${slug}.json`);
      fs.writeFileSync(pjPath, JSON.stringify({ ...personaje, endpoint: endpoint.id, model, creado: new Date().toISOString() }, null, 2));
      console.log(st(`  personaje guardado en ${pjPath} (pendiente para avatares)`, C.dim));
    } catch (e) {
      console.log(st(`  no se pudo guardar el personaje (${e.message}); sigo sin él en disco.`, C.yellow));
      personaje = null;
    }
    // Compilar su avatar con el engine local (texto -> píxeles, sin IA).
    if (personaje && personaje.avatar_desc) {
      const ac = await select('¿Compilo su avatar ahora mismo (engine local)?', [
        { label: 'Sí, compilar avatar', value: 'go' },
        { label: 'No, después', value: 'no' },
      ]);
      if (ac === 0) {
        try {
          const { parseAvatarDesc } = require('./lib-avatar.cjs');
          const engine = loadAvatarEngine();
          const { compileAvatar } = require('./lib-avatar.cjs');
          const c = compileAvatar(engine, personaje.avatar_desc);
          for (const w of c.warnings) console.log(st(`  ~ ${w}`, C.yellow));
          const ap = path.join(STATE_DIR, 'personajes', `${slugAvatar(personaje.nombre)}.png`);
          fs.writeFileSync(ap, c.png);
          personajeAvatar = ap;
          console.log(st(`  ✓ avatar compilado: ${ap} (${c.w}x${c.h})`, C.green));
        } catch (e) {
          console.log(st(`  no se pudo compilar (${e.message}); el personaje sigue sin avatar.`, C.yellow));
        }
      }
    }
  }
  // 5) Review: comando armado igual que el modal (binario + --model universal).
  // Explícito a propósito: "armar" crea un agente VIVO; "solo mostrar" no crea nada.
  const bin = (cli.bins || [cliId])[0];
  const assembled = `${bin} --model ${/\s/.test(model) ? `"${model}"` : model}`;
  console.log('');
  console.log(st('  Revisa antes de armar:', C.bold));
  console.log(`    cli:      ${cliId}`);
  console.log(`    endpoint: ${endpoint ? `${endpoint.label} (${endpoint.baseURL})` : 'el propio del CLI'}`);
  console.log(`    modelo:   ${model}`);
  console.log(`    key:      ${needKey ? (hasKey || linkedWhere ? `● ${needKey}${linkedWhere ? ` (vinculada en ${linkedWhere})` : ' (detectada)'}` : `○ ${needKey} (pendiente: expórtala o vincúlala)`) : 'no requiere'}`);
  if (personaje) {
    console.log(`    personaje: ${personaje.nombre}${personaje.rol ? ` (${personaje.rol})` : ''}`);
    if (personaje.persona) console.log(`    persona:   ${personaje.persona.slice(0, 90)}${personaje.persona.length > 90 ? '…' : ''}`);
    if (personajeAvatar) console.log(`    avatar:    ${personajeAvatar}`);
  }
  console.log(`    comando:  ${assembled}`);
  console.log(st('  OJO: "armar" crea un agente VIVO con PTY en tu sesión de munder. "Solo mostrar" únicamente imprime el comando y no crea nada.', C.yellow));
  const i = await select('¿Armamos el agente con esto?', [
    { label: 'Sí, armar ahora (crea el agente vivo)', value: 'go' },
    { label: 'Solo mostrar el comando (no crea nada)', value: 'show' },
    { label: 'Cancelar', value: 'no' },
  ]);
  if (i < 0 || i === 2) { say('cancelado: nada se creó.'); return; }
  if (i === 1) { console.log(`\n  ${assembled}\n`); say('(solo mostrado: ningún agente creado)'); return; }
  // El id de preset difiere del binario solo en cursor (cursor-agent).
  const provider = cliId === 'cursor-agent' ? 'cursor' : cliId;
  const armarArgs = ['--comando', assembled, '--proveedor', provider];
  if (personaje) {
    armarArgs.push('--nombre', personaje.nombre);
    if (personaje.rol) armarArgs.push('--rol', personaje.rol);
  }
  await cmdSesionArmar(armarArgs);
}

function flagVal(args, names) {
  for (let i = 0; i < args.length; i++) {
    for (const n of names) {
      if (args[i] === n) return args[i + 1] ?? null;
      if (args[i].startsWith(n + '=')) return args[i].slice(n.length + 1);
    }
  }
  return null;
}

async function cmdSesionArmar(args) {
  let nombre = flagVal(args, ['--nombre', '-n']);
  let comando = flagVal(args, ['--comando', '-c']);
  let cwd = flagVal(args, ['--cwd', '--carpeta', '-d']);
  const proveedor = flagVal(args, ['--proveedor', '--provider', '-p']);
  const rol = flagVal(args, ['--rol', '--role', '-r']);
  const interactivo = !nombre || !comando || !cwd;
  if (interactivo && !IS_TTY) {
    die('faltan --nombre/--comando/--cwd y no hay TTY para preguntar. Uso: munder sesion armar --nombre X --comando "..." --cwd ...');
  }
  if (!nombre) nombre = (await ask('  Nombre del agente (p. ej. jim): ')).trim();
  if (!comando) comando = (await ask('  Comando (p. ej. claude --model opus): ')).trim();
  if (!cwd) {
    const pick = await pedirCarpeta(
      'Munder — carpeta de trabajo del agente',
      'Carpeta de trabajo', os.homedir());
    if (!pick) die('sin carpeta, cancelado.');
    cwd = pick;
  }
  if (cwd.startsWith('~/')) cwd = path.join(os.homedir(), cwd.slice(2));
  const spec = { name: nombre, cwd, command: comando };
  if (proveedor) spec.provider = proveedor;
  if (rol) spec.role = rol;
  const ch = readChannel();
  const r = await channelCall('POST', { port: ch.port, path: '/sesion/agentes' }, spec, ch.token)
    .catch((e) => die(`sin respuesta del canal (${e && e.message ? e.message : e})`));
  if (r.status === 200 && r.body && r.body.ok === true) {
    console.log(st('  ✓ agente creado:', C.green, C.bold));
    console.log(`    id:       ${r.body.id}`);
    console.log(`    pty:      ${r.body.ptyId}`);
    if (r.body.provider) console.log(`    proveedor: ${r.body.provider}`);
    if (r.body.cwd) console.log(`    cwd:      ${r.body.cwd}`);
    if (r.body.worktreePath) console.log(`    worktree: ${r.body.worktreePath}`);
    return;
  }
  die(`no se pudo crear (${r.status}): ${(r.body && r.body.error) || 'sin detalle'}`);
}
async function cmdCtl(args) {
  const [sub, ...rest] = args;
  if (sub === 'limpiar' && !rest.length) {
    if (await pruneChannelOrphan()) return;
    const cs = await channelState();
    if (cs.state === 'viva') die('el canal está vivo, no se toca.');
    if (cs.state === 'caida') die('hay procesos del checkout: puede ser arranque en curso, no se toca.');
    console.log('munder: sin archivo de canal, nada que limpiar.');
    return;
  }
  if (sub !== 'ping' || rest.length) die("uso: munder ctl ping | munder ctl limpiar");
  const cfg = readChannel();
  const p = await probeChannel(cfg);
  if (p.alive) {
    console.log(`munder: pong (canal en puerto ${cfg.port})`);
    return;
  }
  if (!pids().length) {
    die(`sin respuesta del canal en puerto ${cfg.port} (${p.detail}). La app murió dejando el archivo: munder ctl limpiar`);
  }
  die(`sin respuesta del canal en puerto ${cfg.port} (${p.detail}). Hay procesos: ¿arranque en curso?`);
}

function cmdPs() {
  const list = pids();
  if (!list.length) { console.log('munder: parado (sin procesos)'); return false; }
  try {
    const out = execFileSync('ps', ['-o', 'pid,ppid,etime,cmd', '-p', list.join(',')], { encoding: 'utf8' });
    console.log(out.trimEnd());
  } catch (e) { console.log((e.stdout || '').trimEnd() || list.join('\n')); }
  return true;
}

